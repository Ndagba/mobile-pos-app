// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  address    String?
  phone      String?
  store_id   String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users        User[]
  products     Product[]
  categories   Category[]
  transactions Transaction[]

  @@index([store_id])
  @@index([is_active])
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  username             String?   @unique
  password_hash        String?
  phone                String?
  first_name           String?
  last_name            String?
  role                 String    @default("cashier") // admin, manager, cashier
  is_super_admin       Boolean   @default(false) // platform operator — can create new stores
  biometric_token_hash String?   @unique
  device_id            String?
  is_active            Boolean   @default(true)
  store_id             String
  branch_id            String?
  last_login_at        DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  deleted_at           DateTime?

  branch              Branch?       @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  transactions        Transaction[]
  audit_logs          AuditLog[]
  voided_transactions Transaction[] @relation("VoidedBy")
  recorded_payments   Payment[]

  @@index([email])
  @@index([username])
  @@index([device_id])
  @@index([store_id])
  @@index([branch_id])
}

model Category {
  id            String   @id @default(uuid())
  name          String
  description   String?
  display_order Int?
  is_active     Boolean  @default(true)
  branch_id     String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  branch   Branch    @relation(fields: [branch_id], references: [id])
  products Product[]

  @@unique([name, branch_id])
  @@index([is_active])
  @@index([branch_id])
}

model Product {
  id              String   @id @default(uuid())
  category_id     String
  sku             String
  name            String
  description     String?
  marked_price    Decimal  @db.Decimal(12, 2)
  effective_price Decimal  @db.Decimal(12, 2)
  cost_price      Decimal? @db.Decimal(12, 2)
  tax_rate        Decimal  @default(0) @db.Decimal(5, 2) // GST percentage
  barcode         String?
  image_url       String?
  unit            String   @default("piece") // piece, kg, liter, etc.
  is_active       Boolean  @default(true)
  branch_id       String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  category          Category          @relation(fields: [category_id], references: [id], onDelete: Cascade)
  branch            Branch            @relation(fields: [branch_id], references: [id])
  inventory         Inventory?
  transaction_items TransactionItem[]
  batches           BatchTracking[]

  @@unique([sku, branch_id])
  @@unique([barcode, branch_id])
  @@index([barcode])
  @@index([category_id])
  @@index([is_active])
  @@index([branch_id])
}

model Inventory {
  id                  String    @id @default(uuid())
  product_id          String    @unique
  quantity_on_hand    BigInt    @default(0)
  quantity_reserved   BigInt    @default(0)
  low_stock_threshold BigInt    @default(10)
  reorder_point       BigInt    @default(20)
  last_stock_check    DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model BatchTracking {
  id                 String   @id @default(uuid())
  product_id         String
  batch_number       String
  manufactured_date  DateTime @db.Date
  expiry_date        DateTime @db.Date
  quantity           BigInt
  warehouse_location String?
  is_expired         Boolean  @default(false)
  created_at         DateTime @default(now())

  product           Product           @relation(fields: [product_id], references: [id], onDelete: Cascade)
  transaction_items TransactionItem[]

  @@unique([product_id, batch_number])
  @@index([expiry_date])
  @@index([is_expired])
}

model Customer {
  id                  String    @id @default(uuid())
  store_id            String? // tenant isolation; null = legacy row (pre-isolation)
  phone               String?   @unique
  email               String?
  first_name          String?
  last_name           String?
  date_of_birth       DateTime? @db.Date
  loyalty_points      BigInt    @default(0)
  total_spent         Decimal   @default(0) @db.Decimal(15, 2)
  transaction_count   Int       @default(0)
  last_transaction_at DateTime?
  credit_limit        Decimal?  @db.Decimal(15, 2) // null = unlimited credit
  notes               String?
  tag                 String? // VIP, New, or null
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  transactions Transaction[]
  payments     Payment[]

  @@index([phone])
  @@index([email])
  @@index([store_id])
}

model Payment {
  id                  String   @id @default(uuid())
  customer_id         String
  amount              Decimal  @db.Decimal(15, 2)
  date                DateTime @db.Date
  notes               String?
  recorded_by_user_id String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  customer         Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  recorded_by_user User?    @relation(fields: [recorded_by_user_id], references: [id], onDelete: SetNull)

  @@index([customer_id])
  @@index([date])
}

model Transaction {
  id                   String    @id @default(uuid())
  store_id             String
  branch_id            String
  user_id              String
  customer_id          String?
  offline_session_hash String?   @unique
  is_sync_online       Boolean   @default(false)
  synced_at            DateTime?
  subtotal             Decimal   @db.Decimal(15, 2)
  tax_amount           Decimal   @default(0) @db.Decimal(15, 2)
  discount_amount      Decimal   @default(0) @db.Decimal(15, 2)
  total_amount         Decimal   @db.Decimal(15, 2)
  payment_method       String // cash, card, mobile_wallet
  payment_status       String    @default("pending") // pending, completed, failed, refunded
  payment_reference    String?
  receipt_number       String?   @unique
  receipt_url          String?
  status               String    @default("completed") // completed, voided, refunded
  void_reason          String?
  voided_at            DateTime?
  voided_by            String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  branch            Branch            @relation(fields: [branch_id], references: [id])
  user              User              @relation(fields: [user_id], references: [id], onDelete: Restrict)
  customer          Customer?         @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  voided_by_user    User?             @relation("VoidedBy", fields: [voided_by], references: [id], onDelete: SetNull)
  transaction_items TransactionItem[]
  sync_queue        OfflineSyncQueue?

  @@index([user_id])
  @@index([store_id])
  @@index([branch_id])
  @@index([customer_id])
  @@index([offline_session_hash])
  @@index([is_sync_online])
  @@index([created_at])
  @@index([payment_status])
}

model TransactionItem {
  id              String   @id @default(uuid())
  transaction_id  String
  product_id      String
  quantity        Int
  unit_price      Decimal  @db.Decimal(12, 2)
  tax_amount      Decimal  @default(0) @db.Decimal(15, 2)
  discount_amount Decimal  @default(0) @db.Decimal(15, 2)
  line_total      Decimal  @db.Decimal(15, 2)
  batch_id        String?
  created_at      DateTime @default(now())

  transaction Transaction    @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [product_id], references: [id], onDelete: Restrict)
  batch       BatchTracking? @relation(fields: [batch_id], references: [id], onDelete: SetNull)

  @@index([transaction_id])
  @@index([product_id])
}

model OfflineSyncQueue {
  id                   String    @id @default(uuid())
  device_id            String
  transaction_id       String    @unique
  offline_session_hash String
  operation_type       String    @default("create") // create, update, void
  payload              Json
  status               String    @default("pending") // pending, syncing, synced, failed, conflict
  attempt_count        Int       @default(0)
  last_error           String?
  created_at           DateTime  @default(now())
  synced_at            DateTime?

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([device_id])
  @@index([status])
  @@index([offline_session_hash])
}

model AuditLog {
  id            String   @id @default(uuid())
  user_id       String?
  action        String // LOGIN, VOID_TRANSACTION, MODIFY_PRODUCT, etc.
  resource_type String? // transaction, inventory, user, etc.
  resource_id   String?
  changes       Json?
  ip_address    String?
  device_id     String?
  created_at    DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@index([resource_type, resource_id])
}

model DailyAnalytics {
  id                    String   @id @default(uuid())
  store_id              String
  branch_id             String?
  report_date           DateTime @db.Date
  total_transactions    Int      @default(0)
  total_revenue         Decimal  @default(0) @db.Decimal(15, 2)
  total_items_sold      BigInt   @default(0)
  avg_transaction_value Decimal  @default(0) @db.Decimal(15, 2)
  top_products          Json?
  payment_breakdown     Json?
  employee_performance  Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([store_id, branch_id, report_date])
  @@index([report_date])
}

// Tenant registry. `id` matches User.store_id, Branch.store_id, etc.
// (those fields are plain strings — no FK enforced — so existing data with
// store_id="store_001" continues to work even before a Store row is backfilled.)
model Store {
  id        String  @id
  name      String
  address   String?
  phone     String?
  currency  String  @default("NGN")
  is_active Boolean @default(true)

  // Subscription tracking
  trial_days_used  Int       @default(0) // Track days in trial
  trial_started_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscription Subscription?
}

model StoreSetting {
  id                           String   @id @default(uuid())
  store_id                     String   @unique
  allow_cashier_add_customers  Boolean  @default(true)
  allow_cashier_edit_customers Boolean  @default(true)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String   @unique // "Business", "Pro"
  slug          String   @unique // "business", "pro"
  max_branches  Int? // null = unlimited
  monthly_price Decimal  @db.Decimal(10, 2) // ₦12500, ₦24000
  is_active     Boolean  @default(true)
  features      Json // {analytics: true, inventory: true}
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id       String @id @default(uuid())
  store_id String @unique
  plan_id  String

  // Billing cycle
  status              String   @default("active") // active, past_due, cancelled, expired
  billing_cycle_start DateTime
  billing_cycle_end   DateTime
  next_renewal_at     DateTime

  // Paystack details
  paystack_customer_id        String?
  paystack_subscription_id    String?
  paystack_authorization_code String? // For recurring charges

  // Trial tracking
  trial_ends_at       DateTime?
  onboarding_fee_paid Boolean   @default(false)
  onboarding_paid_at  DateTime?

  auto_renew   Boolean   @default(true)
  cancelled_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  plan             SubscriptionPlan  @relation(fields: [plan_id], references: [id])
  store            Store             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  paymentReminders PaymentReminder[]

  @@index([store_id])
  @@index([status])
  @@index([next_renewal_at])
  @@map("subscriptions")
}

model Invoice {
  id              String @id @default(uuid())
  subscription_id String

  amount         Decimal @db.Decimal(10, 2)
  currency       String  @default("NGN")
  status         String  @default("unpaid") // unpaid, paid, failed
  invoice_number String  @unique

  // Billing period
  billing_date DateTime @db.Date
  due_date     DateTime @db.Date

  // Payment reference
  paystack_reference String?
  paid_at            DateTime?

  pdf_url    String?
  created_at DateTime @default(now())

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id])
  @@index([status])
  @@map("invoices")
}

model PaymentReminder {
  id              String   @id @default(uuid())
  subscription_id String
  reminder_day    Int // 3 or 7 (days since expiration)
  sent_at         DateTime @default(now())

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@unique([subscription_id, reminder_day])
  @@map("payment_reminders")
}
