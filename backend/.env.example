# Database
DATABASE_URL="postgresql://pos_user:password@localhost:5432/mobilepos"

# Server
PORT=3000
NODE_ENV=development
# TRUST_PROXY=1       # Express trust proxy setting. 1 to trust first proxy (Nginx/Cloudflare/etc.), true to trust all, or false to disable.
# RATE_LIMIT_MAX=1000 # Max general API requests per windowMs (defaults: 2000 in dev, 1000 in prod)
# RATE_LIMIT_WINDOW_MS=900000 # General API rate limit window in milliseconds (default: 15 mins)
# AUTH_RATE_LIMIT_MAX=50 # Max credential requests per windowMs (defaults: 200 in dev, 50 in prod)
# AUTH_RATE_LIMIT_WINDOW_MS=900000 # Credential rate limit window in milliseconds (default: 15 mins)

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_change_in_production

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:5173

# Payment Gateway (Stripe example)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...

# Email Service (NodeMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Logging
LOG_LEVEL=info

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# File Storage (AWS S3)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=mobile-pos-receipts
AWS_REGION=us-east-1
