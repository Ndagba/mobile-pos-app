// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  phone                   String?
  first_name              String?
  last_name               String?
  role                    String    @default("cashier") // admin, manager, cashier
  biometric_token_hash    String?   @unique
  device_id               String?
  is_active               Boolean   @default(true)
  store_id                String
  last_login_at           DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  deleted_at              DateTime?

  transactions            Transaction[]
  audit_logs              AuditLog[]
  voided_transactions     Transaction[] @relation("VoidedBy")

  @@index([email])
  @@index([device_id])
  @@index([store_id])
}

model Category {
  id                String    @id @default(uuid())
  name              String    @unique
  description       String?
  display_order     Int?
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  products          Product[]

  @@index([is_active])
}

model Product {
  id                String    @id @default(uuid())
  category_id       String
  sku               String    @unique
  name              String
  description       String?
  marked_price      Decimal   @db.Decimal(12, 2)
  effective_price   Decimal   @db.Decimal(12, 2)
  cost_price        Decimal?  @db.Decimal(12, 2)
  tax_rate          Decimal   @default(0) @db.Decimal(5, 2) // GST percentage
  barcode           String?   @unique
  image_url         String?
  unit              String    @default("piece") // piece, kg, liter, etc.
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  category          Category  @relation(fields: [category_id], references: [id], onDelete: Cascade)
  inventory         Inventory?
  transaction_items TransactionItem[]
  batches           BatchTracking[]

  @@index([sku])
  @@index([barcode])
  @@index([category_id])
  @@index([is_active])
}

model Inventory {
  id                        String    @id @default(uuid())
  product_id                String    @unique
  quantity_on_hand          BigInt    @default(0)
  quantity_reserved         BigInt    @default(0)
  low_stock_threshold       BigInt    @default(10)
  reorder_point             BigInt    @default(20)
  last_stock_check          DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  product                   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model BatchTracking {
  id                  String    @id @default(uuid())
  product_id          String
  batch_number        String
  manufactured_date   DateTime  @db.Date
  expiry_date         DateTime  @db.Date
  quantity            BigInt
  warehouse_location  String?
  is_expired          Boolean   @default(false)
  created_at          DateTime  @default(now())

  product             Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  transaction_items   TransactionItem[]

  @@unique([product_id, batch_number])
  @@index([expiry_date])
  @@index([is_expired])
}

model Customer {
  id                  String    @id @default(uuid())
  phone               String?   @unique
  email               String?
  first_name          String?
  last_name           String?
  date_of_birth       DateTime? @db.Date
  loyalty_points      BigInt    @default(0)
  total_spent         Decimal   @default(0) @db.Decimal(15, 2)
  transaction_count   Int       @default(0)
  last_transaction_at DateTime?
  notes               String?
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  transactions        Transaction[]

  @@index([phone])
  @@index([email])
}

model Transaction {
  id                      String    @id @default(uuid())
  store_id                String
  user_id                 String
  customer_id             String?
  offline_session_hash    String?   @unique
  is_sync_online          Boolean   @default(false)
  synced_at               DateTime?
  subtotal                Decimal   @db.Decimal(15, 2)
  tax_amount              Decimal   @default(0) @db.Decimal(15, 2)
  discount_amount         Decimal   @default(0) @db.Decimal(15, 2)
  total_amount            Decimal   @db.Decimal(15, 2)
  payment_method          String    // cash, card, mobile_wallet
  payment_status          String    @default("pending") // pending, completed, failed, refunded
  payment_reference       String?
  receipt_number          String?   @unique
  receipt_url             String?
  status                  String    @default("completed") // completed, voided, refunded
  void_reason             String?
  voided_at               DateTime?
  voided_by               String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  user                    User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  customer                Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  voided_by_user          User?     @relation("VoidedBy", fields: [voided_by], references: [id], onDelete: SetNull)
  transaction_items       TransactionItem[]
  sync_queue              OfflineSyncQueue?

  @@index([user_id])
  @@index([store_id])
  @@index([customer_id])
  @@index([offline_session_hash])
  @@index([is_sync_online])
  @@index([created_at])
  @@index([payment_status])
}

model TransactionItem {
  id                String    @id @default(uuid())
  transaction_id    String
  product_id        String
  quantity          Int
  unit_price        Decimal   @db.Decimal(12, 2)
  tax_amount        Decimal   @default(0) @db.Decimal(15, 2)
  discount_amount   Decimal   @default(0) @db.Decimal(15, 2)
  line_total        Decimal   @db.Decimal(15, 2)
  batch_id          String?
  created_at        DateTime  @default(now())

  transaction       Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [product_id], references: [id], onDelete: Restrict)
  batch             BatchTracking? @relation(fields: [batch_id], references: [id], onDelete: SetNull)

  @@index([transaction_id])
  @@index([product_id])
}

model OfflineSyncQueue {
  id                  String    @id @default(uuid())
  device_id           String
  transaction_id      String    @unique
  offline_session_hash String
  operation_type      String    @default("create") // create, update, void
  payload             Json
  status              String    @default("pending") // pending, syncing, synced, failed, conflict
  attempt_count       Int       @default(0)
  last_error          String?
  created_at          DateTime  @default(now())
  synced_at           DateTime?

  transaction         Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([device_id])
  @@index([status])
  @@index([offline_session_hash])
}

model AuditLog {
  id                String    @id @default(uuid())
  user_id           String?
  action            String    // LOGIN, VOID_TRANSACTION, MODIFY_PRODUCT, etc.
  resource_type     String?   // transaction, inventory, user, etc.
  resource_id       String?
  changes           Json?
  ip_address        String?
  device_id         String?
  created_at        DateTime  @default(now())

  user              User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@index([resource_type, resource_id])
}

model DailyAnalytics {
  id                  String    @id @default(uuid())
  store_id            String
  report_date         DateTime  @db.Date
  total_transactions  Int       @default(0)
  total_revenue       Decimal   @default(0) @db.Decimal(15, 2)
  total_items_sold    BigInt    @default(0)
  avg_transaction_value Decimal @default(0) @db.Decimal(15, 2)
  top_products        Json?
  payment_breakdown   Json?
  employee_performance Json?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@unique([store_id, report_date])
  @@index([report_date])
}
