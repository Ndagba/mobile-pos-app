# Base URL of the existing JayPOS backend API. MUST include the /v1 suffix.
# For local on-device/browser testing, point this at your backend host, e.g.
#   http://localhost:3000/v1           (backend on the same machine)
#   http://192.168.1.20:3000/v1        (backend on your LAN)
# Never commit a real production URL or secret here — this file is an example only.
NEXT_PUBLIC_API_URL=http://localhost:3000/v1
