// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id         String   @id @default(uuid())
  name       String
  address    String?
  phone      String?
  store_id   String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users        User[]
  manager_branches ManagerBranch[]
  products     Product[]
  categories   Category[]
  transactions Transaction[]
  stock_counts StockCount[]
  shifts       CashShift[]
  movements    InventoryMovement[]
  purchase_orders PurchaseOrder[]
  goods_receipts  GoodsReceipt[]
  expense_categories ExpenseCategory[]
  expenses Expense[]
  locations Location[]
  bar_orders BarOrder[]

  @@index([store_id])
  @@index([is_active])
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  username             String?   @unique
  password_hash        String?
  phone                String?
  first_name           String?
  last_name            String?
  role                 String    @default("cashier") // admin, manager, cashier
  // Bar-mode duty on top of role='cashier': null | bar_controller | bar_attendant (Phase 1)
  operational_profile  String?
  is_super_admin       Boolean   @default(false) // platform operator — can create new stores
  biometric_token_hash String?   @unique
  device_id            String?
  is_active            Boolean   @default(true)
  store_id             String
  branch_id            String?
  last_login_at        DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  deleted_at           DateTime?

  branch                 Branch?             @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  manager_branches       ManagerBranch[]
  transactions           Transaction[]
  audit_logs             AuditLog[]
  voided_transactions    Transaction[]       @relation("VoidedBy")
  recorded_payments      Payment[]
  stock_counts_started   StockCount[]        @relation("StockCountStartedBy")
  stock_counts_completed StockCount[]        @relation("StockCountCompletedBy")
  shifts                 CashShift[]         @relation("UserShifts")
  movements              InventoryMovement[]
  created_purchase_orders PurchaseOrder[]    @relation("POCreatedBy")
  goods_receipts         GoodsReceipt[]      @relation("GoodsReceivedBy")
  bar_orders_initiated   BarOrder[]          @relation("BarOrderInitiatedBy")
  bar_orders_accepted    BarOrder[]          @relation("BarOrderAcceptedBy")
  bar_orders_fulfilled   BarOrder[]          @relation("BarOrderFulfilledBy")

  @@index([email])
  @@index([username])
  @@index([device_id])
  @@index([store_id])
  @@index([branch_id])
  @@index([store_id, operational_profile])
}

model Category {
  id            String   @id @default(uuid())
  name          String
  description   String?
  display_order Int?
  is_active     Boolean  @default(true)
  branch_id     String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  branch   Branch    @relation(fields: [branch_id], references: [id])
  products Product[]

  @@unique([name, branch_id])
  @@index([is_active])
  @@index([branch_id])
}

model Location {
  id          String   @id @default(uuid())
  name        String
  description String?
  is_active   Boolean  @default(true)
  branch_id   String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  branch   Branch    @relation(fields: [branch_id], references: [id])
  products Product[]

  @@unique([name, branch_id])
  @@index([is_active])
  @@index([branch_id])
}

model Product {
  id              String   @id @default(uuid())
  category_id     String
  location_id     String?
  sku             String
  name            String
  description     String?
  marked_price    Decimal  @db.Decimal(12, 2)
  effective_price Decimal  @db.Decimal(12, 2)
  cost_price      Decimal? @db.Decimal(12, 2)
  tax_rate        Decimal  @default(0) @db.Decimal(5, 2) // GST percentage
  barcode         String?
  image_url       String?
  unit            String   @default("piece") // piece, kg, liter, etc.
  item_type       String   @default("PRODUCT") // PRODUCT or SERVICE
  is_active       Boolean  @default(true)
  branch_id       String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  category          Category            @relation(fields: [category_id], references: [id], onDelete: Cascade)
  location          Location?           @relation(fields: [location_id], references: [id], onDelete: SetNull)
  branch            Branch              @relation(fields: [branch_id], references: [id])
  inventory         Inventory?
  transaction_items TransactionItem[]
  batches           BatchTracking[]
  stock_count_items StockCountItem[]
  movements         InventoryMovement[]
  purchase_order_items PurchaseOrderItem[]
  goods_receipt_items  GoodsReceiptItem[]
  service_components ServiceComponent[] @relation("ServiceToComponents")
  used_in_services ServiceComponent[] @relation("PartToServices")
  bar_order_items BarOrderItem[]

  @@unique([sku, branch_id])
  @@unique([barcode, branch_id])
  @@index([barcode])
  @@index([category_id])
  @@index([location_id])
  @@index([is_active])
  @@index([branch_id])
}

model Inventory {
  id                  String    @id @default(uuid())
  product_id          String    @unique
  quantity_on_hand    Decimal   @default(0) @db.Decimal(15, 4)
  quantity_reserved   Decimal   @default(0) @db.Decimal(15, 4)
  low_stock_threshold Decimal   @default(10) @db.Decimal(15, 4)
  reorder_point       Decimal   @default(20) @db.Decimal(15, 4)
  last_stock_check    DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model BatchTracking {
  id                 String   @id @default(uuid())
  product_id         String
  batch_number       String
  manufactured_date  DateTime @db.Date
  expiry_date        DateTime @db.Date
  quantity           Decimal  @db.Decimal(15, 4)
  warehouse_location String?
  is_expired         Boolean  @default(false)
  created_at         DateTime @default(now())

  product           Product           @relation(fields: [product_id], references: [id], onDelete: Cascade)
  transaction_items TransactionItem[]

  @@unique([product_id, batch_number])
  @@index([expiry_date])
  @@index([is_expired])
}

model Customer {
  id                  String    @id @default(uuid())
  store_id            String? // tenant isolation; null = legacy row (pre-isolation)
  phone               String?   @unique
  email               String?
  first_name          String?
  last_name           String?
  date_of_birth       DateTime? @db.Date
  loyalty_points      BigInt    @default(0)
  total_spent         Decimal   @default(0) @db.Decimal(15, 2)
  transaction_count   Int       @default(0)
  last_transaction_at DateTime?
  credit_limit        Decimal?  @db.Decimal(15, 2) // null = unlimited credit
  notes               String?
  tag                 String? // VIP, New, or null
  is_active           Boolean   @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  transactions Transaction[]
  payments     Payment[]

  @@index([phone])
  @@index([email])
  @@index([store_id])
}

model Payment {
  id                  String   @id @default(uuid())
  customer_id         String
  amount              Decimal  @db.Decimal(15, 2)
  date                DateTime @db.Date
  notes               String?
  recorded_by_user_id String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  customer         Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  recorded_by_user User?    @relation(fields: [recorded_by_user_id], references: [id], onDelete: SetNull)

  @@index([customer_id])
  @@index([date])
}

model Transaction {
  id                   String    @id @default(uuid())
  store_id             String
  branch_id            String
  user_id              String
  customer_id          String?
  offline_session_hash String?   @unique
  is_sync_online       Boolean   @default(false)
  synced_at            DateTime?
  subtotal             Decimal   @db.Decimal(15, 2)
  tax_amount           Decimal   @default(0) @db.Decimal(15, 2)
  discount_amount      Decimal   @default(0) @db.Decimal(15, 2)
  total_amount         Decimal   @db.Decimal(15, 2)
  payment_method       String // cash, card, mobile_wallet, split
  payment_status       String    @default("pending") // pending, completed, failed, refunded
  payment_reference    String?
  payment_splits       Json?
  receipt_number       String?   @unique
  receipt_url          String?
  status               String    @default("completed") // completed, voided, refunded
  void_reason          String?
  voided_at            DateTime?
  voided_by            String?
  // Bar / Lounge (Phase 2): set only for sales posted by fulfilling a bar order.
  // user_id stays the ATTENDANT (seller of record); fulfilled_by_user_id is the
  // Bar Controller who released the drinks. @unique = one order -> at most one sale.
  sales_order_id       String?   @unique
  fulfilled_by_user_id String?
  business_date        DateTime? @db.Date
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  sales_order       BarOrder?         @relation(fields: [sales_order_id], references: [id], onDelete: Restrict)
  branch            Branch            @relation(fields: [branch_id], references: [id])
  user              User              @relation(fields: [user_id], references: [id], onDelete: Restrict)
  customer          Customer?         @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  voided_by_user    User?             @relation("VoidedBy", fields: [voided_by], references: [id], onDelete: SetNull)
  transaction_items TransactionItem[]
  sync_queue        OfflineSyncQueue?

  @@index([user_id])
  @@index([store_id])
  @@index([branch_id])
  @@index([customer_id])
  @@index([offline_session_hash])
  @@index([is_sync_online])
  @@index([created_at])
  @@index([payment_status])
  @@index([business_date])
}

model TransactionItem {
  id              String   @id @default(uuid())
  transaction_id  String
  product_id      String
  quantity        Decimal  @db.Decimal(15, 4)
  unit_price      Decimal  @db.Decimal(12, 2)
  cost_price      Decimal? @db.Decimal(12, 2)
  tax_amount      Decimal  @default(0) @db.Decimal(15, 2)
  discount_amount Decimal  @default(0) @db.Decimal(15, 2)
  line_total      Decimal  @db.Decimal(15, 2)
  batch_id        String?
  created_at      DateTime @default(now())

  transaction Transaction    @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [product_id], references: [id], onDelete: Restrict)
  batch       BatchTracking? @relation(fields: [batch_id], references: [id], onDelete: SetNull)

  @@index([transaction_id])
  @@index([product_id])
}

model OfflineSyncQueue {
  id                   String    @id @default(uuid())
  device_id            String
  transaction_id       String    @unique
  offline_session_hash String
  operation_type       String    @default("create") // create, update, void
  payload              Json
  status               String    @default("pending") // pending, syncing, synced, failed, conflict
  attempt_count        Int       @default(0)
  last_error           String?
  created_at           DateTime  @default(now())
  synced_at            DateTime?

  transaction Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([device_id])
  @@index([status])
  @@index([offline_session_hash])
}

model AuditLog {
  id            String   @id @default(uuid())
  store_id      String?
  branch_id     String?
  user_id       String?
  action        String // LOGIN, VOID_TRANSACTION, MODIFY_PRODUCT, etc.
  resource_type String? // transaction, inventory, user, etc.
  resource_id   String?
  changes       Json?
  ip_address    String?
  device_id     String?
  created_at    DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@index([resource_type, resource_id])
}

model DailyAnalytics {
  id                    String   @id @default(uuid())
  store_id              String
  branch_id             String?
  report_date           DateTime @db.Date
  total_transactions    Int      @default(0)
  total_revenue         Decimal  @default(0) @db.Decimal(15, 2)
  total_items_sold      BigInt   @default(0)
  avg_transaction_value Decimal  @default(0) @db.Decimal(15, 2)
  top_products          Json?
  payment_breakdown     Json?
  employee_performance  Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([store_id, branch_id, report_date])
  @@index([report_date])
}

// Tenant registry. `id` matches User.store_id, Branch.store_id, etc.
// (those fields are plain strings — no FK enforced — so existing data with
// store_id="store_001" continues to work even before a Store row is backfilled.)
model Store {
  id        String  @id
  name      String
  address   String?
  phone     String?
  currency  String  @default("NGN")
  is_active Boolean @default(true)

  // Business mode (Bar/Lounge planning, Phase 1): retail | bar.
  // Admin may choose it until the first sale; afterwards super-admin only (audited).
  business_mode        String    @default("retail")
  business_mode_set_at DateTime?

  // Subscription tracking
  trial_days_used  Int       @default(0) // Track days in trial
  trial_started_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscription Subscription?
}

model StoreSetting {
  id                           String   @id @default(uuid())
  store_id                     String   @unique
  allow_cashier_add_customers  Boolean  @default(true)
  allow_cashier_edit_customers Boolean  @default(true)
  customer_menu_enabled        Boolean  @default(true)
  supplier_menu_enabled        Boolean  @default(true)
  // Store profile (printed on receipts)
  business_name                String?
  rc_number                    String?
  store_address                String?
  // Tax + receipt
  tax_rate                     Decimal? @db.Decimal(5, 2)
  receipt_footer               String?
  receipt_show_logo            Boolean  @default(true)
  // Additional cashier permissions
  allow_cashier_refund         Boolean  @default(false)
  allow_cashier_discount       Boolean  @default(true)
  max_discount_percent         Int?
  // Bar / Lounge (Phase 1). Damage is always a house loss (D24) → no damage-charge column.
  bar_business_day_cutoff_hour    Int      @default(6)
  bar_timezone                    String   @default("Africa/Lagos")
  bar_attendant_discount          Boolean  @default(false)
  bar_allow_backdated_remittance  Boolean  @default(false)
  bar_require_payment_declaration Boolean  @default(false)
  // Commission (D27: rate × attendant's total sales)
  commission_enabled              Boolean  @default(false)
  commission_rate                 Decimal? @db.Decimal(5, 2)
  commission_basis                String   @default("total_sales")
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt
}

model ManagerBranch {
  id         String   @id @default(uuid())
  user_id    String
  branch_id  String
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([user_id, branch_id])
  @@index([user_id])
  @@index([branch_id])
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String   @unique // "Business", "Pro"
  slug          String   @unique // "business", "pro"
  max_branches  Int? // null = unlimited
  monthly_price Decimal  @db.Decimal(10, 2) // ₦12500, ₦24000
  is_active     Boolean  @default(true)
  features      Json // {analytics: true, inventory: true}
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id       String @id @default(uuid())
  store_id String @unique
  plan_id  String

  // Billing cycle
  status              String   @default("active") // active, past_due, cancelled, expired
  billing_cycle_start DateTime
  billing_cycle_end   DateTime
  next_renewal_at     DateTime

  // Paystack details
  paystack_customer_id        String?
  paystack_subscription_id    String?
  paystack_authorization_code String? // For recurring charges

  // Trial tracking
  trial_ends_at       DateTime?
  onboarding_fee_paid Boolean   @default(false)
  onboarding_paid_at  DateTime?

  auto_renew   Boolean   @default(true)
  cancelled_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  plan             SubscriptionPlan  @relation(fields: [plan_id], references: [id])
  store            Store             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  paymentReminders PaymentReminder[]

  @@index([store_id])
  @@index([status])
  @@index([next_renewal_at])
  @@map("subscriptions")
}

model Invoice {
  id              String @id @default(uuid())
  subscription_id String

  amount         Decimal @db.Decimal(10, 2)
  currency       String  @default("NGN")
  status         String  @default("unpaid") // unpaid, paid, failed
  invoice_number String  @unique

  // Billing period
  billing_date DateTime @db.Date
  due_date     DateTime @db.Date

  // Payment reference
  paystack_reference String?
  paid_at            DateTime?

  pdf_url    String?
  created_at DateTime @default(now())

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id])
  @@index([status])
  @@map("invoices")
}

model PaymentReminder {
  id              String   @id @default(uuid())
  subscription_id String
  reminder_day    Int // 3 or 7 (days since expiration)
  sent_at         DateTime @default(now())

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@unique([subscription_id, reminder_day])
  @@map("payment_reminders")
}

// ─── Supplier Management ──────────────────────────────────────

model Supplier {
  id         String   @id @default(uuid())
  store_id   String // tenant isolation
  name       String
  phone      String?
  email      String?
  address    String?
  category   String? // maps to product category name
  notes      String?
  tag        String? // Preferred, Blocked, or null
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  invoices        PurchaseInvoice[]
  payments        SupplierPayment[]
  purchase_orders PurchaseOrder[]

  @@index([store_id])
  @@index([name])
}

model PurchaseInvoice {
  id                  String    @id @default(uuid())
  supplier_id         String
  store_id            String
  invoice_number      String?
  invoice_date        DateTime  @db.Date
  due_date            DateTime? @db.Date
  quantity            Decimal?  @db.Decimal(15, 4)
  unit_price          Decimal?  @db.Decimal(15, 2)
  amount              Decimal   @db.Decimal(15, 2)
  status              String    @default("unpaid") // unpaid, partial, paid
  notes               String?
  recorded_by_user_id String?
  purchase_order_id   String? // set when auto-created from a goods receipt (Phase 4B, opt-in)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  supplier       Supplier       @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  purchase_order PurchaseOrder? @relation(fields: [purchase_order_id], references: [id], onDelete: SetNull)

  @@index([supplier_id])
  @@index([store_id])
  @@index([status])
  @@index([invoice_date])
  @@index([purchase_order_id])
}

model SupplierPayment {
  id                  String   @id @default(uuid())
  supplier_id         String
  invoice_id          String?
  amount              Decimal  @db.Decimal(15, 2)
  date                DateTime @db.Date
  notes               String?
  recorded_by_user_id String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  supplier Supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)

  @@index([supplier_id])
  @@index([invoice_id])
  @@index([date])
}

// ─── Audit Features ───────────────────────────────────────────

model StockCount {
  id                   String    @id @default(uuid())
  store_id             String
  branch_id            String
  status               String    @default("in_progress") // in_progress, completed
  started_at           DateTime  @default(now())
  completed_at         DateTime?
  started_by_user_id   String
  completed_by_user_id String?
  notes                String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  branch       Branch           @relation(fields: [branch_id], references: [id])
  started_by   User             @relation("StockCountStartedBy", fields: [started_by_user_id], references: [id])
  completed_by User?            @relation("StockCountCompletedBy", fields: [completed_by_user_id], references: [id])
  items        StockCountItem[]

  @@index([store_id])
  @@index([branch_id])
  @@index([status])
}

model StockCountItem {
  id                String  @id @default(uuid())
  stock_count_id    String
  product_id        String
  system_quantity   Decimal  @db.Decimal(15, 4)
  physical_quantity Decimal? @db.Decimal(15, 4)
  variance          Decimal? @db.Decimal(15, 4)
  notes             String?

  stock_count StockCount @relation(fields: [stock_count_id], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [product_id], references: [id])

  @@index([stock_count_id])
  @@index([product_id])
}

model CashShift {
  id               String    @id @default(uuid())
  store_id         String
  branch_id        String
  user_id          String
  status           String    @default("open") // open, closed
  opening_balance  Decimal   @db.Decimal(15, 2)
  expected_closing Decimal?  @db.Decimal(15, 2)
  actual_closing   Decimal?  @db.Decimal(15, 2)
  overage_shortage Decimal?  @db.Decimal(15, 2)
  opened_at        DateTime  @default(now())
  closed_at        DateTime?
  notes            String?

  user   User   @relation("UserShifts", fields: [user_id], references: [id])
  branch Branch @relation(fields: [branch_id], references: [id])

  @@index([store_id])
  @@index([branch_id])
  @@index([user_id])
  @@index([status])
}

model InventoryMovement {
  id            String   @id @default(uuid())
  store_id      String
  branch_id     String
  product_id    String
  movement_type String // sale, purchase, adjustment, transfer
  quantity      Decimal  @db.Decimal(15, 4) // positive for addition, negative for deduction
  reference_id  String? // transaction_id, invoice_id, stock_count_id
  notes         String?
  user_id       String?
  timestamp     DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id])
  branch  Branch  @relation(fields: [branch_id], references: [id])
  user    User?   @relation(fields: [user_id], references: [id])

  @@index([store_id])
  @@index([branch_id])
  @@index([product_id])
  @@index([movement_type])
  @@index([timestamp])
}

// ─── Procurement (Phase 4B) ───────────────────────────────────
// Purchase-order lifecycle: draft → ordered → partially_received → received
// (or cancelled before any receipt). Receiving is the ONLY new stock-in path —
// it increments Inventory.quantity_on_hand and writes a `purchase` InventoryMovement.

model PurchaseOrder {
  id                 String    @id @default(uuid())
  store_id           String // tenant isolation (string, not FK — matches Transaction/Supplier)
  branch_id          String // receiving location
  supplier_id        String
  po_number          String // human ref, unique per store (see @@unique)
  status             String    @default("draft") // draft, ordered, partially_received, received, cancelled
  order_date         DateTime? @db.Date // set when moved to "ordered"
  expected_date      DateTime? @db.Date
  currency           String    @default("NGN") // single-currency today; column reserved
  subtotal           Decimal   @default(0) @db.Decimal(15, 2) // Σ(line qty × unit_cost)
  tax_amount         Decimal   @default(0) @db.Decimal(15, 2)
  total_amount       Decimal   @default(0) @db.Decimal(15, 2)
  notes              String?
  created_by_user_id String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  supplier   Supplier            @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  branch     Branch              @relation(fields: [branch_id], references: [id])
  created_by User?               @relation("POCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  items      PurchaseOrderItem[]
  receipts   GoodsReceipt[]
  invoices   PurchaseInvoice[]

  @@unique([store_id, po_number])
  @@index([store_id])
  @@index([branch_id])
  @@index([supplier_id])
  @@index([status])
  @@index([order_date])
}

model PurchaseOrderItem {
  id                String  @id @default(uuid())
  purchase_order_id String
  product_id        String
  quantity_ordered  Decimal @db.Decimal(15, 4)
  quantity_received Decimal @default(0) @db.Decimal(15, 4) // running total across receipts
  unit_cost         Decimal @db.Decimal(15, 2)
  line_total        Decimal @db.Decimal(15, 2) // quantity_ordered × unit_cost (server-computed)
  notes             String?

  purchase_order PurchaseOrder      @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  product        Product            @relation(fields: [product_id], references: [id], onDelete: Restrict)
  receipt_items  GoodsReceiptItem[]

  @@index([purchase_order_id])
  @@index([product_id])
}

model GoodsReceipt {
  id                  String   @id @default(uuid())
  store_id            String
  branch_id           String
  purchase_order_id   String
  received_date       DateTime @db.Date
  reference           String? // supplier delivery note / waybill no.
  receipt_hash        String?  @unique // optional idempotency key (double-submit safety)
  notes               String?
  received_by_user_id String?
  created_at          DateTime @default(now())

  purchase_order PurchaseOrder      @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  branch         Branch             @relation(fields: [branch_id], references: [id])
  received_by    User?              @relation("GoodsReceivedBy", fields: [received_by_user_id], references: [id], onDelete: SetNull)
  items          GoodsReceiptItem[]

  @@index([store_id])
  @@index([branch_id])
  @@index([purchase_order_id])
  @@index([received_date])
}

model GoodsReceiptItem {
  id                     String    @id @default(uuid())
  goods_receipt_id       String
  purchase_order_item_id String
  product_id             String
  quantity_received      Decimal   @db.Decimal(15, 4)
  unit_cost              Decimal   @db.Decimal(15, 2) // captured for cost history; defaults from the PO line
  batch_number           String? // when the product is batch-tracked
  expiry_date            DateTime? @db.Date

  goods_receipt       GoodsReceipt      @relation(fields: [goods_receipt_id], references: [id], onDelete: Cascade)
  purchase_order_item PurchaseOrderItem @relation(fields: [purchase_order_item_id], references: [id], onDelete: Restrict)
  product             Product           @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([goods_receipt_id])
  @@index([purchase_order_item_id])
  @@index([product_id])
}

model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  branch_id   String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  branch   Branch    @relation(fields: [branch_id], references: [id])
  expenses Expense[]

  @@index([branch_id])
}

model Expense {
  id                String   @id @default(uuid())
  category_id       String
  branch_id         String
  amount            Decimal  @db.Decimal(15, 2)
  description       String?
  expenseDate       DateTime @db.Date
  paymentMethod     String
  referenceNumber   String?
  status            String   @default("recorded") // recorded, voided
  createdBy         String
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  category ExpenseCategory @relation(fields: [category_id], references: [id])
  branch   Branch          @relation(fields: [branch_id], references: [id])

  @@index([category_id])
  @@index([branch_id])
  @@index([expenseDate])
}

model ServiceComponent {
  id                  String   @id @default(uuid())
  service_id          String
  product_id         String?
  component_type      String   // PART or LABOR
  quantity            Decimal  @default(1) @db.Decimal(15, 4)
  default_labor_cost  Decimal? @db.Decimal(12, 2)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  service Product @relation("ServiceToComponents", fields: [service_id], references: [id])
  product Product? @relation("PartToServices", fields: [product_id], references: [id])

  @@index([service_id])
  @@index([product_id])
}

// ─── Bar / Lounge (Phase 2) ───────────────────────────────────
// A pending order an Attendant (Cashier Two) sends to the Bar Controller (Cashier One).
// Kept OUT of Transaction so unfulfilled orders can never count as revenue.
// Lifecycle: submitted -> accepted -> fulfilled | cancelled | rejected; fulfilled -> reversed.
// Fulfilment posts exactly one completed Transaction (Transaction.sales_order_id @unique)
// attributed to the Attendant, in the same DB transaction that marks the order fulfilled.

model BarOrder {
  id                      String    @id @default(uuid())
  store_id                String
  branch_id               String
  order_number            String // e.g. B-20261117-0007, unique per store
  client_ref              String    @unique // idempotency key from the submitting device
  status                  String    @default("submitted") // submitted | accepted | fulfilled | reversal_requested | cancelled | rejected | reversed
  initiated_by_user_id    String // Attendant — the seller of record
  accepted_by_user_id     String?
  fulfilled_by_user_id    String?
  table_label             String?
  notes                   String?
  subtotal                Decimal   @db.Decimal(15, 2) // server-computed at submit (D8 price snapshot)
  tax_amount              Decimal   @db.Decimal(15, 2)
  discount_amount         Decimal   @default(0) @db.Decimal(15, 2)
  total_amount            Decimal   @db.Decimal(15, 2)
  fulfilled_total         Decimal?  @db.Decimal(15, 2) // after any reductions
  customer_payment_method String? // cash | transfer | card | split
  customer_payment_splits Json?
  customer_payment_ref    String?
  business_date           DateTime? @db.Date // set at fulfilment
  submitted_at            DateTime  @default(now())
  accepted_at             DateTime?
  fulfilled_at            DateTime?
  closed_reason           String? // cancel / reject / reversal / reduction reason
  closed_by_user_id       String?
  closed_at               DateTime?
  // Phase 3: reversal request (Attendant/Controller) -> manager approves or declines
  reversal_requested_by_user_id String?
  reversal_requested_at         DateTime?
  reversal_request_reason       String?
  // Phase 4: the releasing Bar Controller's day close that covers this order
  day_close_id                  String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  branch       Branch         @relation(fields: [branch_id], references: [id])
  initiated_by User           @relation("BarOrderInitiatedBy", fields: [initiated_by_user_id], references: [id], onDelete: Restrict)
  accepted_by  User?          @relation("BarOrderAcceptedBy", fields: [accepted_by_user_id], references: [id], onDelete: SetNull)
  fulfilled_by User?          @relation("BarOrderFulfilledBy", fields: [fulfilled_by_user_id], references: [id], onDelete: SetNull)
  items        BarOrderItem[]
  transaction  Transaction?

  @@unique([store_id, order_number])
  @@index([store_id, branch_id, status])
  @@index([initiated_by_user_id, status])
  @@index([business_date])
  @@index([day_close_id])
}

model BarOrderItem {
  id                 String   @id @default(uuid())
  bar_order_id       String
  product_id         String
  quantity_requested Decimal  @db.Decimal(15, 4)
  quantity_fulfilled Decimal? @db.Decimal(15, 4) // <= requested; null until fulfilment
  unit_price         Decimal  @db.Decimal(12, 2) // snapshot at submit
  tax_rate           Decimal  @db.Decimal(5, 2) // snapshot at submit
  line_total         Decimal  @db.Decimal(15, 2) // unit_price x quantity_requested (excl. tax, house rule)

  bar_order BarOrder @relation(fields: [bar_order_id], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([bar_order_id])
  @@index([product_id])
}

// ─── Bar / Lounge (Phase 3): Attendant ledger + remittances ───
// What each Attendant owes the house is the SUM of their ledger entries — never a
// stored balance — so it carries forward across days automatically and is never
// reset. Entries are append-only; corrections are reversing entries that point at
// the original (reverses_entry_id @unique => an entry can be reversed only once).

model CashierLedgerEntry {
  id                  String   @id @default(uuid())
  store_id            String
  branch_id           String
  cashier_user_id     String // the Attendant whose balance this moves
  entry_type          String // SALE | SALE_REVERSAL | REMITTANCE | REMITTANCE_REVERSAL | WRITE_OFF | ADJUSTMENT
  amount              Decimal  @db.Decimal(15, 2) // signed: + increases what the Attendant owes
  business_date       DateTime @db.Date
  source_type         String // bar_order | remittance | write_off | adjustment
  source_id           String
  reverses_entry_id   String?  @unique
  reason              String?
  recorded_by_user_id String
  created_at          DateTime @default(now())

  @@unique([entry_type, source_type, source_id])
  @@index([store_id, cashier_user_id, business_date])
  @@index([store_id, business_date])
}

model CashierRemittance {
  id                  String    @id @default(uuid())
  store_id            String
  branch_id           String
  cashier_user_id     String // Attendant paying in
  received_by_user_id String // Bar Controller / manager
  amount              Decimal   @db.Decimal(15, 2) // > 0
  method              String // cash | transfer | card | other
  reference           String? // required for transfer / card
  narration           String?
  business_date       DateTime  @db.Date
  client_ref          String    @unique // idempotency (double-tap safety)
  status              String    @default("recorded") // recorded | reversed
  reversed_by_user_id String?
  reversed_at         DateTime?
  reversal_reason     String?
  day_close_id        String? // Phase 4: the receiving Bar Controller's day close
  created_at          DateTime  @default(now())

  @@index([store_id, cashier_user_id, business_date])
  @@index([store_id, business_date])
  @@index([store_id, method, reference])
  @@index([day_close_id])
}

// ─── Bar / Lounge (Phase 4): damages + day close ──────────────

// Flat / damaged stock. Always a HOUSE LOSS (decision D24): it never touches the
// Attendant ledger and is never a sale. Stock leaves via a 'damage' InventoryMovement.
model DamageRecord {
  id                  String    @id @default(uuid())
  store_id            String
  branch_id           String
  product_id          String
  quantity            Decimal   @db.Decimal(15, 4)
  reason_code         String // flat | broken | bad_cap | expired | other
  notes               String?
  responsible_user_id String? // Attendant involved (analytics only), or null = house
  recorded_by_user_id String
  unit_cost           Decimal?  @db.Decimal(12, 2) // snapshot of cost_price → loss value
  unit_price          Decimal   @db.Decimal(12, 2) // snapshot of selling price → lost sales value
  business_date       DateTime  @db.Date
  client_ref          String    @unique
  status              String    @default("recorded") // recorded | reversed
  reversed_by_user_id String?
  reversed_at         DateTime?
  reversal_reason     String?
  day_close_id        String?
  created_at          DateTime  @default(now())

  @@index([store_id, business_date])
  @@index([responsible_user_id])
  @@index([product_id])
  @@index([day_close_id])
}

// One close per Bar Controller per business day (decision D11). The snapshot is
// frozen at submission; reopening (manager) unlocks the day, resubmitting replaces it.
model BarDayClose {
  id                      String    @id @default(uuid())
  store_id                String
  branch_id               String
  business_date           DateTime  @db.Date
  closed_by_user_id       String // the Bar Controller
  status                  String    @default("submitted") // submitted | acknowledged | reopened
  snapshot                Json // frozen figures at submission
  expected_cash           Decimal   @db.Decimal(15, 2)
  expected_transfer       Decimal   @db.Decimal(15, 2)
  expected_card           Decimal   @db.Decimal(15, 2)
  expected_other          Decimal   @db.Decimal(15, 2)
  counted_cash            Decimal   @db.Decimal(15, 2)
  variance                Decimal   @db.Decimal(15, 2) // counted − expected cash
  variance_reason         String?
  notes                   String?
  submitted_at            DateTime  @default(now())
  acknowledged_by_user_id String?
  acknowledged_amount     Decimal?  @db.Decimal(15, 2) // cash the manager actually received
  acknowledged_at         DateTime?
  ack_note                String?
  variance_treatment      String? // absorb | charge_controller (D23, shortage only)
  reopened_by_user_id     String?
  reopened_at             DateTime?
  reopen_reason           String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@unique([branch_id, business_date, closed_by_user_id])
  @@index([store_id, business_date])
  @@index([status])
}
